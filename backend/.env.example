# ==============================================================================
# EventPilot AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit or share your real .env file!
# ==============================================================================

# Supabase PostgreSQL Session Pooler URI (Recommended: Port 5432 or 6543, sslmode=require)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# CORS: Comma-separated list of allowed web origins (wildcard * is strictly forbidden in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Environment Mode
ENVIRONMENT=development

# OpenAPI / Swagger Documentation Toggle (default false in production, true in development)
ENABLE_DOCS=true

# Admin Bearer Token for GET /internal/metrics
ADMIN_TOKEN=your-secure-admin-token-here

# Connection Pool & Concurrency Configuration
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_TIMEOUT=5.0
DB_POOL_MAX_WAITING=50
MAX_INFLIGHT=60

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_READS=120
RATE_LIMIT_WRITES=30
RATE_LIMIT_BURSTS=10
